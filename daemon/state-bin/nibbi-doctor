#!/bin/bash
# Read-only diagnostics. No stale-lock deletion, automatic restart, or credential output.
set -euo pipefail
exec node --input-type=module - <<'NODE'
const port = Number(process.env.NIBBI_PORT || 4527);
try {
  const response = await fetch('http://127.0.0.1:' + port + '/nibbi/health', { signal: AbortSignal.timeout(3000) });
  const health = await response.json();
  if (!response.ok || health.app !== 'nibbi' || health.protocolVersion !== 1 || health.brain !== true) throw new Error('Incompatible backend');
  console.log('✓ Nibbi ' + health.version + ' · one backend on :' + port);
  console.log('  Vault: ' + health.status.vault + ' · busy: ' + health.status.busy);
  console.log('  Pairing: ' + (health.remote ? 'HTTPS enabled' : 'local only'));
  const snapshot = await (await fetch('http://127.0.0.1:' + port + '/api/snapshot')).json();
  const review = snapshot.fixers.filter(run => ['failed', 'interrupted', 'staged'].includes(run.status));
  console.log('  ' + review.length + ' retained runs to review in Settings → Activity');
} catch (error) { console.error('✗ ' + error.message + '. Check the launchd log and docs/PLATFORM-MIGRATION.md. Do not remove worktrees or owner locks blindly.'); process.exitCode = 1; }
for (const [name, port] of [['Kokoro', 4521], ['Whisper', 4522]]) {
  try { const result = await fetch('http://127.0.0.1:' + port + '/health', { signal: AbortSignal.timeout(1000) }); console.log((result.ok ? '✓ ' : '• ') + name + ' optional voice service'); }
  catch { console.log('• ' + name + ' not running (optional)'); }
}
NODE
