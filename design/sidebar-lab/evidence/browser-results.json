{
  "environment": "local Chrome via Playwright; geometry in CSS pixels at the page's real viewport (?scale=1). Not a device benchmark, and it certifies neither Safari/WKWebView nor the native Tauri shell.",
  "checks": [
    {
      "name": "No horizontal overflow: 10 states × 5 sizes"
    },
    {
      "name": "Every state marks the open conversation, the current section, the card, the way back and the backdrop"
    },
    {
      "name": "Every control in the bar is at least 44px on a phone and 32px on a desktop"
    },
    {
      "name": "Text at 12px and under is at least 4.5:1 against its own background"
    },
    {
      "name": "Every design dispatches only what handleMarginAction already understands",
      "scope": "thread newThread projectSection",
      "scope-a": "thread newThread projectSection",
      "scope-b": "thread newThread projectSection",
      "scope-c": "thread newThread projectSection"
    },
    {
      "name": "Escape closes the card first and keeps focus, then closes the bar"
    },
    {
      "name": "With reduced motion nothing animates in any of five moments: switch, card, drawer, collapsed, home"
    },
    {
      "name": "60 projects mount in under 250ms",
      "scope": "3ms",
      "scope-a": "1ms",
      "scope-b": "1ms",
      "scope-c": "1ms"
    },
    {
      "name": "destroy() leaves nothing behind"
    },
    {
      "name": "The lab page itself has no horizontal overflow at 420px"
    },
    {
      "name": "No console or page errors"
    }
