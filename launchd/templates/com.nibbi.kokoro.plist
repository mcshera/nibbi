<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.nibbi.kokoro</string>
  <key>ProgramArguments</key><array>
    <string>__STATE__/venv/bin/python</string>
    <string>__STATE__/bin/kokoro-server.py</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__STATE__/logs/kokoro-server.log</string>
  <key>StandardErrorPath</key><string>__STATE__/logs/kokoro-server.log</string>
  <key>EnvironmentVariables</key><dict>
    <key>VIRTUAL_ENV</key><string>__STATE__/venv</string>
    <key>PATH</key><string>__STATE__/venv/bin:__STATE__/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>NIBBI_STATE_DIR</key><string>__STATE__</string>
    <key>HOME</key><string>__HOME__</string>
  </dict>
</dict></plist>
