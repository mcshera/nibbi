<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.nibbi.host</string>
  <key>ProgramArguments</key><array>
    <string>__NODE__</string>
    <string>__REPO__/server.mjs</string>
    <string>--port</string><string>4527</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.nibbi/logs/nibbi-host.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.nibbi/logs/nibbi-host.log</string>
  <key>EnvironmentVariables</key><dict><key>HOME</key><string>__HOME__</string></dict>
</dict></plist>
